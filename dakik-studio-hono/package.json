{
  "name": "dakik-studio-hono",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "npm run build:client+ssr && wrangler dev src/index.ts --port 8787",
    "dev:frontend": "vite",
    "build": "wrangler deploy --dry-run",
    "build:frontend": "vite build",
    "build:ssr": "vite build --ssr entry-server.tsx",
    "build:client+ssr": "npm run build:frontend && npm run build:ssr",
    "deploy": "npm run build:client+ssr && wrangler deploy",
    "cf-typegen": "wrangler types",
    "check-types": "tsc --noEmit",
    "build:registry": "node scripts/build-bits-registry.mjs",
    "seed:registry": "node scripts/seed-registry-sql.mjs"
  },
  "dependencies": {
    "@ark-ui/react": "^5.37.2",
    "@hono/zod-validator": "^0.4.0",
    "@prisma/adapter-d1": "^7.8.0",
    "@prisma/client": "^7.5.0",
    "@tanstack/react-query": "^5.62.0",
    "@unhead/react": "^2.0.0",
    "better-auth": "^1.5.6",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "googleapis": "^171.4.0",
    "hono": "^4.7.0",
    "lucide-react": "^1.7.0",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.13.2",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.0",
    "stripe": "^21.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250415.0",
    "@phosphor-icons/web": "^2.1.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "lucide-static": "^1.17.0",
    "material-icons": "^1.13.14",
    "postcss": "^8.5.8",
    "prisma": "^7.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.0",
    "vite": "^8.0.2",
    "wrangler": "^4.0.0"
  }
}
