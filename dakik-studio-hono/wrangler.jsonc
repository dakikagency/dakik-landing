{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dakik-studio",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Route every navigation through the worker (for per-request SSR + the
    // hostname-aware catch-all), but let the asset layer serve static files
    // directly — negative patterns bypass the worker entirely (free-tier safe).
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/landing/*",
      "!/dakik_logo.svg",
      "!/image.png",
      "!/og-default.png",
      "!/favicon.ico",
      "!/video.mp4",
      "!/faq.mp4",
      "!/faq2.mp4",
      "!/faq3.mp4"
    ]
  },

  "routes": [
    { "pattern": "dakik.co.uk", "custom_domain": true },
    { "pattern": "www.dakik.co.uk", "custom_domain": true },
    { "pattern": "icons.dakik.co.uk", "custom_domain": true },
    { "pattern": "bits.dakik.co.uk", "custom_domain": true },
    { "pattern": "flow.dakik.co.uk", "custom_domain": true }
  ],

  "vars": {
    "ENVIRONMENT": "production"
  },

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "dakik-media"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dakik-studio",
      "database_id": "fa44c798-e860-4927-96d2-e376bd3ce21a"
    }
  ],

  "observability": {
    "enabled": true
  }
}
